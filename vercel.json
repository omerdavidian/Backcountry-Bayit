{
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        { "type": "host", "value": "bcbayit.org" }
      ],
      "destination": "https://backcountrybayit.com/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        { "type": "host", "value": "www.bcbayit.org" }
      ],
      "destination": "https://backcountrybayit.com/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/(.*)", "destination": "/" }
  ],
  "buildCommand": "npm run build",
  "outputDirectory": "build",
  "framework": "create-react-app"
}
