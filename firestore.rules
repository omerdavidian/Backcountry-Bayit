
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Events: public read, managers can write
    match /events/{eventId} {
      allow read: if true;
      allow write: if request.auth != null &&
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'manager');
    }

    // RSVPs: public create and update (with validation), managers can read/update/delete
    match /rsvps/{rsvpId} {
      // Allow public read so client can check capacity and duplicates
      allow read: if true;

      // Anyone can create an RSVP as long as required fields are present and valid types
      allow create: if
        request.resource.data.keys().hasAll(['eventId','firstName','lastName','email','status','timestamp']) &&
        request.resource.data.eventId is string &&
        request.resource.data.firstName is string &&
        request.resource.data.lastName is string &&
        request.resource.data.email is string &&
        request.resource.data.status in ['approved','pending','waitlist'] &&
        request.resource.data.timestamp is timestamp;
      
      // Public edits are limited to guest contact details. In particular, a
      // caller must not be able to approve themselves, move an RSVP to a
      // different event, or alter the original submission timestamp.
      allow update: if
        request.resource.data.email == resource.data.email &&
        request.resource.data.keys().hasAll(['eventId','firstName','lastName','email','status']) &&
        request.resource.data.eventId == resource.data.eventId &&
        request.resource.data.status == resource.data.status &&
        request.resource.data.timestamp == resource.data.timestamp &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'firstName', 'lastName', 'phone', 'attendees',
          'dietaryRestrictions', 'updatedAt'
        ]);
      
      // Managers and admins can read, update, delete all RSVPs
      allow read, update, delete: if request.auth != null &&
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'manager');
    }

    // Users: only admins can read/write
    match /users/{userId} {
      allow read, write: if request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
  }
}
